@using TimeNPlace.Components.Map.Plugins

<section class="timenplace-map-container" aria-label="Map">
    <Map loadParameters="@_loadParameters"
         OnAfterMapLoaded="@OnAfterMapLoaded"
         height="100%"
         width="100%">
        
        <MapPlugins>
            <ZoomControlPlugin
                Map="@context.map"
                Position="topright"
                Enabled="true">
            </ZoomControlPlugin>
            <MapClickPlugin
                Map="@context.map"
                L="@context.LeafletCore"
                OnMapClick="HandleMapClick">
            </MapClickPlugin>
        </MapPlugins>
    </Map>
</section>

@code {
    [Parameter] public EventCallback<MapClickDetails> OnMapClick { get; set; }
    private Map? map;
    
    private LoadParameters _loadParameters = new()
    {
        // TODO: consider dynamically assigning current location
        location = new Location()
        {
            latitude = 41.6938,
            longitude = 44.8015
        },
        zoomLevel = 15
    };

    private async Task HandleMapClick(MapClickDetails details)
    {
        await OnMapClick.InvokeAsync(details);
    }

    public class MapClickDetails
    {
        public double Latitude { get; set; }
        public double Longitude { get; set; }
    }

    private async Task OnAfterMapLoaded(MapEventArgs args)
    {
        map = args.sender as Map;
        
        // LeafletForBlazor attribution
        await map.Attribution.Add(
            "<a href=\"https://github.com/ichim/LeafletForBlazor-NuGet\">LeafletForBlazor</a>"
        );
    }
}