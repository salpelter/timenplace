@* TODO: implement *@
<section class="@GetSearchCssClass()" aria-label="Place search">
    <BbInputGroup Class="timenplace-search-group">
        <BbInputGroupAddon Align="InputGroupAlign.InlineStart">
            <LucideIcon Name="search" Size="16" />
        </BbInputGroupAddon>
        <BbInputGroupInput Type="InputType.Search"
                           Placeholder="Search for a city, landmark, or address"
                           AriaLabel="Search for a city, landmark, or address" />
        <BbInputGroupAddon Align="InputGroupAlign.InlineEnd">
            <BbInputGroupText>/</BbInputGroupText>
        </BbInputGroupAddon>
    </BbInputGroup>
</section>

@code {
    [Parameter] public bool IsExpanded { get; set; }

    private string GetSearchCssClass()
    {
        return IsExpanded
            ? "timenplace-search timenplace-search-expanded"
            : "timenplace-search";
    }
}