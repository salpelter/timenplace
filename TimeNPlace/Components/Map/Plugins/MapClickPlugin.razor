@inject IJSRuntime Js

@implements IAsyncDisposable

@code {
    [Parameter] public IJSObjectReference? Map { get; set; }
    [Parameter] public IJSObjectReference? L { get; set; }
    [Parameter] public EventCallback<MapContainer.MapClickDetails> OnMapClick { get; set; }

    private DotNetObjectReference<MapClickPlugin>? dotNetReference;

    // component lifecycle method called after component has rendered HTML
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // TODO: parent should guarantee that valid map objects exist on the first render of this plugin
        // initialize only once
        if (!firstRender || Map is null || L is null)
            return;

        // TODO: don't forget to remove extra logging
        // TODO: make js function name a variable and rename
        await Js.InvokeVoidAsync(
            "eval", """
                    window.enableBlazorMapClick = function (map, L, dotNet) {
                        console.log("Map click plugin initialized", map, L);

                        let marker = null;

                        map.on('click', function (e) {
                            console.log("Map clicked", e.latlng);

                            const { lat, lng } = e.latlng.wrap();

                            if (marker) {
                                marker.setLatLng([lat, lng]);
                            } else {
                                marker = L.marker([lat, lng]).addTo(map);
                            }

                            dotNet.invokeMethodAsync('HandleMapClick', lat, lng);
                        });
                    };
                    """);

        // a proxy representing this particular plugin instance
        dotNetReference = DotNetObjectReference.Create(this);

        await Js.InvokeVoidAsync(
            "enableBlazorMapClick",
            Map,
            L,
            dotNetReference);
    }

    [JSInvokable]
    public async Task HandleMapClick(double lat, double lng)
    {
        await OnMapClick.InvokeAsync(new MapContainer.MapClickDetails
        {
            Latitude = lat,
            Longitude = lng
        });
    }

    public ValueTask DisposeAsync()
    {
        dotNetReference?.Dispose();
        // TODO: should the js handler also be disposed?
        return ValueTask.CompletedTask;
    }
}