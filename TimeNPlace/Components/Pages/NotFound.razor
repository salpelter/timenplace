@page "/not-found"

<PageTitle>Not Found</PageTitle>

<main class="timenplace-status-page">
    <section class="timenplace-status-card" aria-labelledby="not-found-title">
        <h1 id="not-found-title" class="timenplace-status-title">Page not found</h1>
        <p class="timenplace-status-message">
            Sorry, the page you are looking for does not exist.
        </p>
        <BbButton Href="/" Size="ButtonSize.Small">Back to map</BbButton>
    </section>
</main>